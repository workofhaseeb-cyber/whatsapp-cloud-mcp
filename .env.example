# Required (Meta for Developers > WhatsApp > API Setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Required only for list_message_templates
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional
WHATSAPP_API_VERSION=v27.0
WHATSAPP_DEFAULT_COUNTRY_CODE=971
WHATSAPP_DRY_RUN=0
# Directory whose files may be uploaded via upload_media's file_path.
# Leave unset to disable local-file uploads (url uploads still work).
WHATSAPP_UPLOAD_DIR=
# Webhook helper
WHATSAPP_APP_SECRET=
